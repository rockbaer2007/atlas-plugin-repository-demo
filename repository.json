{
  "kind": "atlas.plugin.repository",
  "atlas": {
    "type": "plugin-repository",
    "schemaVersion": 1
  },
  "name": "ATLAS Plugin Demo Repository",
  "version": "27",
  "homepage": "https://github.com/rockbaer2007/atlas-plugin-repository-demo",
  "installPage": "https://rockbaer2007.github.io/atlas-plugin-repository-demo/install.html",
  "homeAssistantRepositoryUrl": "https://my.home-assistant.io/redirect/supervisor_add_addon_repository/?repository_url=https%3A%2F%2Fgithub.com%2Frockbaer2007%2Fatlas-plugin-repository-demo",
  "maintainer": "UGSo Software",
  "plugins": [
    {
      "id": "atlas.demo.simple-file-editor",
      "atlas": {
        "type": "plugin",
        "schemaVersion": 1
      },
      "name": "ATLAS Simple File Editor",
      "version": "0.1.14",
      "description": "Demo plugin for testing ATLAS repository install, update and removal.",
      "homepage": "https://github.com/rockbaer2007/atlas-plugin-repository-demo/tree/main/plugins/simple-file-editor",
      "installPage": "https://rockbaer2007.github.io/atlas-plugin-repository-demo/install.html",
      "homeAssistantRepositoryUrl": "https://my.home-assistant.io/redirect/supervisor_add_addon_repository/?repository_url=https%3A%2F%2Fgithub.com%2Frockbaer2007%2Fatlas-plugin-repository-demo",
      "icon": "./plugins/simple-file-editor/icon.svg",
      "logo": "./plugins/simple-file-editor/logo.svg",
      "preview": "./plugins/simple-file-editor/preview.svg",
      "package": "./plugins/simple-file-editor/simple-file-editor.atlas-plugin.json",
      "manifest": "./plugins/simple-file-editor/atlas-plugin.json",
      "capabilities": [
        "atlas.plugin.demo",
        "homeassistant.file-editor"
      ],
      "compatibility": {
        "atlas": ">=0.1.31",
        "host": "administration-local",
        "homeAssistant": ">=2026.8"
      }
    },
    {
      "id": "atlas.plugin.file-studio",
      "atlas": {
        "type": "plugin",
        "schemaVersion": 1
      },
      "name": "ATLAS File Studio",
      "nameI18n": {
        "de": "ATLAS File Studio",
        "en": "ATLAS File Studio"
      },
      "version": "0.1.12",
      "description": "Scoped file tree and editor plugin for Home Assistant configuration files.",
      "descriptionI18n": {
        "de": "Abgesichertes Dateibaum- und Editor-Plugin für Home-Assistant-Konfigurationsdateien.",
        "en": "Scoped file tree and editor plugin for Home Assistant configuration files."
      },
      "homepage": "https://github.com/rockbaer2007/atlas-file-studio-plugin",
      "installPage": "https://rockbaer2007.github.io/atlas-file-studio-plugin/install.html",
      "icon": "https://raw.githubusercontent.com/rockbaer2007/atlas-file-studio-plugin/main/plugins/file-studio/icon.svg",
      "preview": "https://raw.githubusercontent.com/rockbaer2007/atlas-file-studio-plugin/main/plugins/file-studio/preview.svg",
      "entry": "/plugin-assets/file-studio/index.html",
      "package": "https://raw.githubusercontent.com/rockbaer2007/atlas-file-studio-plugin/main/plugins/file-studio/atlas-plugin-file-studio.atlas-plugin.json",
      "manifest": "https://raw.githubusercontent.com/rockbaer2007/atlas-file-studio-plugin/main/plugins/file-studio/atlas-plugin.json",
      "capabilities": [
        "atlas.file-tree",
        "atlas.file-editor",
        "atlas.syntax-highlighting",
        "atlas.yaml-validation",
        "atlas.file-upload",
        "atlas.file-download",
        "atlas.scoped-filesystem"
      ],
      "compatibility": {
        "atlas": ">=0.1.54",
        "host": "administration-local",
        "homeAssistant": ">=2026.8"
      }
    }
  ]
}
